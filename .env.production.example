# --- Usado pelo docker compose ---
VITE_API_URL=https://morae.synergylab.tech
MYSQL_PASSWORD=troque
MYSQL_ROOT_PASSWORD=troque

# --- API ---
# Server=mysql é o nome do serviço no compose. A senha é a mesma do MYSQL_PASSWORD.
ConnectionStrings__DefaultConnection=Server=mysql;Port=3306;Database=moraeDB;User=morae;Password=troque;

Jwt__Secret=troque-por-um-segredo-novo-com-pelo-menos-32-caracteres
Jwt__Issuer=MoreaApi
Jwt__Audience=MoreaClient
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=7

MasterUser__Email=seu-email-real
MasterUser__Password=troque

App__FrontendUrl=https://morae.synergylab.tech
Cors__Origins=https://morae.synergylab.tech

Resend__ApiKey=
Resend__From=MORAÊ <nao-responda@morae.synergylab.tech>
Resend__TestRecipient=

Commercial__WhatsAppNumber=

# Rede interna do Docker: o Docker repassa as conexões do Caddy com um IP 172.x
ForwardedHeaders__KnownNetworks=172.16.0.0/12

MercadoPago__ClientId=
MercadoPago__ClientSecret=
MercadoPago__Environment=Production
MercadoPago__OAuthRedirectUri=https://morae.synergylab.tech/api/mercadopago/oauth/callback
MercadoPago__WebhookUrl=https://morae.synergylab.tech/api/mercadopago/webhooks
MercadoPago__WebhookSecret=
MercadoPago__WebhookSignatureToleranceMinutes=5
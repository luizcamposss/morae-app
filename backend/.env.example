# Banco (a porta deve bater com MYSQL_PORT do docker-compose; padrão 3306)
ConnectionStrings__DefaultConnection=Server=localhost;Port=3306;Database=moraeDB;User=root;Password=root;

# JWT
Jwt__Secret=troque-por-um-segredo-com-pelo-menos-32-caracteres
Jwt__Issuer=MoreaApi
Jwt__Audience=MoreaClient
Jwt__ExpiresInMinutes=60

# Usuário Master criado pelo seeder
MasterUser__Email=master@example.com
MasterUser__Password=TroqueEstaSenha123

# Mercado Pago (Sandbox ou Production)
MercadoPago__ClientId=
MercadoPago__ClientSecret=
MercadoPago__Environment=Sandbox
MercadoPago__OAuthRedirectUri=http://localhost:5242/api/mercadopago/oauth/callback
MercadoPago__OAuthSuccessRedirectUrl=http://localhost:5173/mercadopago/return?status=success
MercadoPago__OAuthFailureRedirectUrl=http://localhost:5173/mercadopago/return?status=error
MercadoPago__WebhookUrl=https://seu-tunel.ngrok.app/api/mercadopago/webhooks
MercadoPago__WebhookSecret=
MercadoPago__WebhookSignatureToleranceMinutes=5
MercadoPago__CheckoutSuccessUrl=http://localhost:5173/payments/return?status=success
MercadoPago__CheckoutFailureUrl=http://localhost:5173/payments/return?status=failure
MercadoPago__CheckoutPendingUrl=http://localhost:5173/payments/return?status=pending
